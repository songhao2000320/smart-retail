<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.retail.mapper.StoreMapper">

    <resultMap id="storeMap" type="com.retail.entity.Store">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="address" property="address"/>
        <result column="phone" property="phone"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAll" resultMap="storeMap">
        SELECT * FROM t_store WHERE status = 1 ORDER BY create_time DESC
    </select>

    <select id="selectByPage" resultMap="storeMap">
        SELECT * FROM t_store WHERE status = 1 ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM t_store WHERE status = 1
    </select>

</mapper>
