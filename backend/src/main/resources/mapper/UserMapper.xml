<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.retail.mapper.UserMapper">

    <resultMap id="userMap" type="com.retail.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="store_id" property="storeId"/>
        <result column="status" property="status"/>
        <result column="locked_until" property="lockedUntil"/>
        <result column="login_fail_count" property="loginFailCount"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByUsername" resultMap="userMap">
        SELECT * FROM t_user WHERE username = #{username}
    </select>

    <select id="selectList" resultMap="userMap">
        SELECT * FROM t_user
        <where>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countList" resultType="int">
        SELECT COUNT(*) FROM t_user
        <where>
            <if test="role != null and role != ''">
                AND role = #{role}
            </if>
        </where>
    </select>

    <update id="updateRole">
        UPDATE t_user SET role = #{role} WHERE id = #{userId}
    </update>

    <update id="updateLoginFail">
        UPDATE t_user
        SET login_fail_count = #{count},
            status = #{status},
            locked_until = #{lockedUntil}
        WHERE id = #{userId}
    </update>

    <update id="updateStatus">
        UPDATE t_user SET status = #{status} WHERE id = #{userId}
    </update>

</mapper>
