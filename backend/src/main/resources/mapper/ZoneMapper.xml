<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.retail.mapper.ZoneMapper">

    <resultMap id="zoneMap" type="com.retail.entity.Zone">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="name" property="name"/>
        <result column="pos_x" property="posX"/>
        <result column="pos_y" property="posY"/>
        <result column="width" property="width"/>
        <result column="height" property="height"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByStoreId" resultMap="zoneMap">
        SELECT * FROM t_zone WHERE store_id = #{storeId} AND status = 1 ORDER BY create_time ASC
    </select>

    <update id="deleteByStoreId">
        UPDATE t_zone SET status = 0 WHERE store_id = #{storeId}
    </update>

</mapper>
